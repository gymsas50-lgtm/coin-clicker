<?xml version='1.0' encoding='utf-8'?>
<roblox version="4"><Item class="Tool" referent="SwordTool"><Properties><string name="Name">Royal Sword</string><string name="ToolTip">Сапфировый страж</string><bool name="RequiresHandle">true</bool><bool name="CanBeDropped">false</bool><CoordinateFrame name="Grip"><X>0</X><Y>0</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame></Properties><Item class="Part" referent="Part1"><Properties><string name="Name">Handle</string><bool name="Anchored">false</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="Massless">true</bool><token name="Material">256</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>0</Y><Z>0</Z><R00>1.0</R00><R01>-0.0</R01><R02>0</R02><R10>0.0</R10><R11>1.0</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>0.28</X><Y>1.1</Y><Z>0.28</Z></Vector3><Color3 name="Color"><R>0.13725490196078433</R><G>0.15294117647058825</G><B>0.19607843137254902</B></Color3></Properties></Item><Item class="Script" referent="SwordGripAlignment"><Properties><string name="Name">GripAlignment</string><ProtectedString name="Source">-- Keep the blade upright and the centre of the handle at the hand socket.
local tool = script.Parent
local RunService = game:GetService("RunService")
local connection
local function stop()
    if connection then connection:Disconnect(); connection = nil end
end
tool.Equipped:Connect(function()
    stop()
    local character = tool.Parent
    local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not hand or not root then return end
    task.spawn(function()
        local grip = hand:WaitForChild("RightGrip", 3)
        if not grip or tool.Parent ~= character then return end
        local socket = grip.C0.Position
        local function align()
            if tool.Parent ~= character or not grip.Parent then stop(); return end
            local at = hand.CFrame:PointToWorldSpace(socket)
            local right = Vector3.new(root.CFrame.RightVector.X, 0, root.CFrame.RightVector.Z)
            if right.Magnitude &lt; 0.01 then return end
            right = right.Unit
            local up = Vector3.yAxis
            local upright = CFrame.fromMatrix(at, right, up, right:Cross(up)) * CFrame.Angles(0, math.rad(90), 0)
            grip.C1 = CFrame.identity
            grip.C0 = hand.CFrame:ToObjectSpace(upright)
        end
        align()
        connection = RunService.Heartbeat:Connect(align)
    end)
end)
tool.Unequipped:Connect(stop)
tool.Destroying:Connect(stop)
